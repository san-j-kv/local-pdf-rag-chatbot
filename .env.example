# Copy to .env and edit. All values are optional; these are the defaults.
# Docker Compose reads this file automatically.

# Ollama model used to answer questions.
CHAT_MODEL=llama3.2

# Ollama model used to embed document chunks.
EMBED_MODEL=nomic-embed-text

# Relevance cut-off (cosine distance, lower = stricter).
# Also adjustable live in the app sidebar.
RELEVANCE_MAX_DISTANCE=0.55
